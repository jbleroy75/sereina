# Copier en .env et remplir. Ne jamais commiter le .env.

# Général
PORT=3000
SITE_URL=https://www.votre-domaine.fr
COOKIE_SECRET=changez-moi-chaine-longue-aleatoire
DIST_DIR=../dist
DB_PATH=./data/sereina.db
RETENTION_DAYS=90
HEALTH_SECRET=                     # optionnel : Bearer pour GET /api/health?details=1 depuis un outil de surveillance
SHUTDOWN_DRAIN_MS=15000

# IA (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
MODEL_CHAT=claude-sonnet-4-5
MODEL_RISK=claude-haiku-4-5
# MOCK_AI=1   # réponses simulées, sans clé, pour tester

# Essai gratuit puis crédits (1 crédit = 1 message)
FREE_MINUTES=5
FREE_MESSAGES=8
# Packs : cle:credits:centimes:libellé (même valeur à donner au build.py pour les pages)
PACKS=petit:20:490:Petit pack,moyen:60:1290:Pack confort,grand:150:2490:Grand pack
DEFAULT_PACK=moyen
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...    # endpoint : POST https://www.votre-domaine.fr/api/stripe/webhook, événement checkout.session.completed

# Back-office (https://www.votre-domaine.fr/admin/)
# Compte propriétaire créé au premier démarrage s'il n'existe aucun admin ; changement de mot de passe exigé à la première connexion.
ADMIN_EMAIL=vous@votre-domaine.fr
ADMIN_PASSWORD=Mot-de-passe-provisoire-12
# Clé de chiffrement des secrets de double authentification : openssl rand -hex 32
TOTP_ENCRYPTION_KEY=

CONTACT_EMAIL=contact@votre-domaine.fr   # destinataire du formulaire de contact

# Alertes orange / rouge vers l'équipe d'astreinte (au moins un canal)
ALERT_EMAIL=astreinte@votre-domaine.fr
SMTP_HOST=smtp.votre-fournisseur.fr
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alertes@votre-domaine.fr
# Telegram (alertes rouge/orange, anti-spam 6 h par utilisateur)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...   (Slack, Discord, Teams)
# SMS rouge uniquement (Twilio)
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=+33...
# ALERT_SMS_TO=+33...
